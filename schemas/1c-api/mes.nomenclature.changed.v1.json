{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mes.nomenclature.changed.v1.json",
  "title": "mes.nomenclature.changed.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["eventId", "eventTime", "source", "payload"],
  "properties": {
    "eventId": { "type": "string", "description": "UUID события" },
    "eventTime": { "type": "string", "format": "date-time" },
    "source": { "type": "string", "description": "Идентификатор продюсера, опубликовавшего событие (например, '1c-mes-kitchen', 'mes-api'). Нужен для аудита и чтобы консьюмер мог игнорировать свои же события" },
    "payload": {
      "type": "object",
      "description": "Номенклатура — снимок состояния после изменения",
      "additionalProperties": false,
      "required": ["guid", "name", "code", "unit", "deletion_mark"],
      "properties": {
        "guid":          { "type": "string", "format": "uuid", "description": "GUID номенклатуры" },
        "name":          { "type": "string", "description": "Наименование блюда/товара" },
        "code":          { "type": "string", "description": "Код номенклатуры" },
        "unit":          { "type": "string", "format": "uuid", "description": "GUID базовой единицы измерения" },
        "deletion_mark": { "type": "boolean", "description": "Пометка на удаление в 1С" }
      }
    }
  }
}
